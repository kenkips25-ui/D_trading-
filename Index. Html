<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="style.css">
    <title>TradePro Terminal</title>
</head>
<body>
    <nav class="sidebar">
        <div class="logo">TradePro</div>
        <ul>
            <li>Dashboard</li>
            <li>Markets</li>
            <li>Portfolio</li>
            <li>Settings</li>
        </ul>
    </nav>
    <main class="dashboard">
        <header>
            <h1>BTC/USD <span class="price">$64,230.50</span></h1>
            <div class="actions">
                <button class="buy">BUY</button>
                <button class="sell">SELL</button>
            </div>
        </header>
        <div class="chart-container" id="chart">
            <!-- Chart placeholder -->
            <canvas id="tradingChart"></canvas>
        </div>
    </main>
    <script src="script.js"></script>
</body>
</html>
